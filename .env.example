# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env

# Yapay zekâ arka ucu: cli | api | none
#   cli  -> Claude aboneliği (Pro/Max). Token almak için kendi bilgisayarınızda: claude setup-token
#   api  -> Claude API anahtarı (kullanım başına ücret)
#   none -> yalnız kural motoru (yapay zekâsız, test için)
LLM_BACKEND=cli

# LLM_BACKEND=cli ise:
CLAUDE_CODE_OAUTH_TOKEN=

# LLM_BACKEND=api ise:
ANTHROPIC_API_KEY=

# Telefon köprüsü (Mac'te çalışan Appium). Docker içinden Mac'e erişim adresi:
APPIUM_URL=http://host.docker.internal:4723
